# Server Configuration
PORT=3001

# Anthropic API (required)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Helicone Analytics (optional)
HELICONE_API_KEY=sk-helicone-xxxxx

# Google OAuth Configuration (required for user authentication)
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# JWT Configuration (required for production)
# Generate a secure random string for production: openssl rand -hex 64
JWT_SECRET=your-secure-jwt-secret-change-in-production

# Database Configuration (optional)
# Default: ./data/sibo.db (relative to server directory)
DATABASE_PATH=./data/sibo.db
